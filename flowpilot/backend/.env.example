# Copy this file to .env and fill in your own values.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
# Get this from MongoDB Atlas -> Database -> Connect -> Drivers
# Replace <username>, <password> and the cluster host with your own.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/flowpilot?retryWrites=true&w=majority

# Any long random string. You can generate one with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# The URL your app is served from (used for CORS + cookies).
# In production this MUST be set to your real deployed URL (e.g.
# https://flowpilot.onrender.com) - without it, cross-origin requests are
# blocked by default once NODE_ENV=production.
CLIENT_URL=http://localhost:5000
